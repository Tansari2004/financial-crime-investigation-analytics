# Used in Phase 2, after PostgreSQL is running locally.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=financial_crime
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Banking pipeline Docker Compose uses its own database on port 5433 by default.
# Set these to override its local defaults; do not commit real passwords.
# BANKING_POSTGRES_DB=banking_pipeline
# BANKING_POSTGRES_USER=banking
# BANKING_POSTGRES_PASSWORD=banking_local_only
# BANKING_POSTGRES_PORT=5433
# BANKING_DATABASE_URL=postgresql://banking:banking_local_only@localhost:5433/banking_pipeline
