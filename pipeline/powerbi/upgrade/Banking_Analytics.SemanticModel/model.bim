{
  "name": "Banking_Analytics",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "DimDate",
        "description": "",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "dd MMM yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"Vc6xEYAgEADBXohl5u8RhVoY+m9DQy7cbNcqGZk1Zg3Kvg6m2czb7OZjvuYwp0iYXuEVXuEVXuEVXvGv9gc=\"}),",
                "    Data = Json.Document(Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Data, {\"Date\"}),",
                "    Selected = Table.SelectColumns(Rows, {\"Date\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"Date\", type date}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "DimCurrency",
        "description": "",
        "columns": [
          {
            "name": "Currency",
            "dataType": "string",
            "sourceColumn": "Currency",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "DimCurrency",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"Xc5LCgIxDAbgq5SuvYTPjQhDi4uhzCK2AYOhlXbCqKd3aLsQd9+fhCTO6a2UOQMTRHVIzJD1tHF6R7NPFJszfIiVQeCa9xAh/M0fJaeKC77Ir70BSysYuTF2PbHJggRSht59o73jAzsXKkWdMkRf8/WshiQxtGB/b47Y/hsFVkxf\"}),",
                "    Data = Json.Document(Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Data, {\"Currency\"}),",
                "    Selected = Table.SelectColumns(Rows, {\"Currency\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"Currency\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "DimFormat",
        "description": "",
        "columns": [
          {
            "name": "Payment format",
            "dataType": "string",
            "sourceColumn": "Payment format",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "DimFormat",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"i45WcnT2UIrViVZyyixJzs/MA7OdE4szIIyM1MLSVAizKDUls0TBObEoBcwPSs3MK0stLslNzSsBC4RnFgFVxgIA\"}),",
                "    Data = Json.Document(Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Data, {\"Payment format\"}),",
                "    Selected = Table.SelectColumns(Rows, {\"Payment format\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"Payment format\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "DimFile",
        "description": "",
        "columns": [
          {
            "name": "File key",
            "dataType": "int64",
            "sourceColumn": "File key",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Dataset",
            "dataType": "string",
            "sourceColumn": "Dataset",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "DimFile",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"i4421FHydPJVcPT1UfDw1A3OTczJUYqNBQA=\"}),",
                "    Data = Json.Document(Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Data, {\"File key\", \"Dataset\"}),",
                "    Selected = Table.SelectColumns(Rows, {\"File key\", \"Dataset\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"File key\", Int64.Type}, {\"Dataset\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "DimRule",
        "description": "Disconnected selector for the Rule Hits measure; no relationship is intended.",
        "columns": [
          {
            "name": "Rule",
            "dataType": "string",
            "sourceColumn": "Rule",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "DimRule",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"i45W8shMz1BIzM0vzStRitWB8jPyS4tyKhXKUnPykzNLKsESQakFqYklqSkKySC1qUUFiUUgmVgA\"}),",
                "    Data = Json.Document(Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Data, {\"Rule\"}),",
                "    Selected = Table.SelectColumns(Rows, {\"Rule\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"Rule\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "FactDaily",
        "description": "One row per event date / payment currency / payment format. Full source daily fact aggregated across sender banks without a row limit.",
        "columns": [
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "dd MMM yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "Currency",
            "dataType": "string",
            "sourceColumn": "Currency",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Payment format",
            "dataType": "string",
            "sourceColumn": "Payment format",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Transactions",
            "dataType": "int64",
            "sourceColumn": "Transactions",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Alerts",
            "dataType": "int64",
            "sourceColumn": "Alerts",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Synthetic labels",
            "dataType": "int64",
            "sourceColumn": "Synthetic labels",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "High amount hits",
            "dataType": "int64",
            "sourceColumn": "High amount hits",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "High velocity hits",
            "dataType": "int64",
            "sourceColumn": "High velocity hits",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Repeat counterparty hits",
            "dataType": "int64",
            "sourceColumn": "Repeat counterparty hits",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "FactDaily",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"\"}),",
                "    Data = Json.Document(Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Data, {\"Date\", \"Currency\", \"Payment format\", \"Transactions\", \"Alerts\", \"Synthetic labels\", \"High amount hits\", \"High velocity hits\", \"Repeat counterparty hits\"}),",
                "    Selected = Table.SelectColumns(Rows, {\"Date\", \"Currency\", \"Payment format\", \"Transactions\", \"Alerts\", \"Synthetic labels\", \"High amount hits\", \"High velocity hits\", \"Repeat counterparty hits\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"Date\", type date}, {\"Currency\", type text}, {\"Payment format\", type text}, {\"Transactions\", Int64.Type}, {\"Alerts\", Int64.Type}, {\"Synthetic labels\", Int64.Type}, {\"High amount hits\", Int64.Type}, {\"High velocity hits\", Int64.Type}, {\"Repeat counterparty hits\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Transaction Count",
            "expression": [
              "SUM(FactDaily[Transactions])"
            ],
            "displayFolder": "Activity",
            "description": "Complete published daily fact, not the detail sample.",
            "formatString": "#,0"
          },
          {
            "name": "Risk Alert Count",
            "expression": [
              "SUM(FactDaily[Alerts])"
            ],
            "displayFolder": "Activity",
            "description": "Distinct transactions with rule score at least two.",
            "formatString": "#,0"
          },
          {
            "name": "Alert Rate",
            "expression": [
              "DIVIDE([Risk Alert Count], [Transaction Count])"
            ],
            "displayFolder": "Activity",
            "description": "Numerator and denominator share the current date/currency/format context.",
            "formatString": "0.00%"
          },
          {
            "name": "Synthetic Label Count",
            "expression": [
              "SUM(FactDaily[Synthetic labels])"
            ],
            "displayFolder": "Evaluation",
            "description": "Synthetic answer-key labels; not verified real crime.",
            "formatString": "#,0"
          },
          {
            "name": "Previous Day Transactions",
            "expression": [
              "VAR CurrentDate = SELECTEDVALUE(DimDate[Date])",
              "RETURN IF(NOT ISBLANK(CurrentDate), CALCULATE([Transaction Count], REMOVEFILTERS(DimDate), DimDate[Date] = CurrentDate - 1))"
            ],
            "displayFolder": "Activity",
            "description": "Returns blank if there is no single current date or no preceding observation.",
            "formatString": "#,0"
          },
          {
            "name": "Daily Change",
            "expression": [
              "IF(NOT ISBLANK([Previous Day Transactions]), [Transaction Count] - [Previous Day Transactions])"
            ],
            "displayFolder": "Activity",
            "description": "Daily comparison at a single event date; preserves the other filters.",
            "formatString": "#,0;-#,0"
          },
          {
            "name": "Daily Change Percent",
            "expression": [
              "DIVIDE([Daily Change], [Previous Day Transactions])"
            ],
            "displayFolder": "Activity",
            "description": "Blank when the prior day is unavailable or zero.",
            "formatString": "0.0%;-0.0%"
          },
          {
            "name": "Selected Format Share",
            "expression": [
              "DIVIDE([Transaction Count], CALCULATE([Transaction Count], ALLSELECTED(DimFormat[Payment format])))"
            ],
            "displayFolder": "Activity",
            "description": "Share within the externally selected formats, retaining other dimensions.",
            "formatString": "0.0%"
          },
          {
            "name": "High Amount Hits",
            "expression": [
              "SUM(FactDaily[High amount hits])"
            ],
            "displayFolder": "Rules",
            "description": "Transactions meeting the high-amount rule; flags can overlap.",
            "formatString": "#,0"
          },
          {
            "name": "High Velocity Hits",
            "expression": [
              "SUM(FactDaily[High velocity hits])"
            ],
            "displayFolder": "Rules",
            "description": "Transactions meeting the high-hourly-velocity rule; flags can overlap.",
            "formatString": "#,0"
          },
          {
            "name": "Repeated Counterparty Hits",
            "expression": [
              "SUM(FactDaily[Repeat counterparty hits])"
            ],
            "displayFolder": "Rules",
            "description": "Includes one-point repeated-counterparty signals below the alert threshold.",
            "formatString": "#,0"
          },
          {
            "name": "Rule Hits",
            "expression": [
              "SWITCH(SELECTEDVALUE(DimRule[Rule]),",
              "    \"High amount\", [High Amount Hits],",
              "    \"High hourly velocity\", [High Velocity Hits],",
              "    \"Repeated counterparty\", [Repeated Counterparty Hits],",
              "    BLANK())"
            ],
            "displayFolder": "Rules",
            "description": "Intentionally disconnected rule selector; never sum these counts as distinct alerts.",
            "formatString": "#,0"
          },
          {
            "name": "Source Rows",
            "expression": [
              "SUM(FileQuality[Source rows])"
            ],
            "displayFolder": "Quality",
            "description": "All selected source files; event-date/format slicers do not apply.",
            "formatString": "#,0"
          },
          {
            "name": "Accepted Rows",
            "expression": [
              "SUM(FileQuality[Accepted rows])"
            ],
            "displayFolder": "Quality",
            "description": "File acceptance count, separate from event-date-filtered transaction count.",
            "formatString": "#,0"
          },
          {
            "name": "Rejected Rows",
            "expression": [
              "SUM(FileQuality[Rejected rows])"
            ],
            "displayFolder": "Quality",
            "description": "Invalid rejects; duplicate candidates are counted separately.",
            "formatString": "#,0"
          },
          {
            "name": "Duplicate Candidates",
            "expression": [
              "SUM(FileQuality[Duplicate candidates])"
            ],
            "displayFolder": "Quality",
            "description": "Excluded from the published transaction fact.",
            "formatString": "#,0"
          },
          {
            "name": "Row Balance Variance",
            "expression": [
              "[Source Rows] - [Accepted Rows] - [Rejected Rows] - [Duplicate Candidates]"
            ],
            "displayFolder": "Quality",
            "description": "Zero is expected; missing data is separately checked by Quality Status.",
            "formatString": "#,0"
          },
          {
            "name": "Reconciliation Failures",
            "expression": [
              "SUM(CurrencyReconciliation[Failure count])"
            ],
            "displayFolder": "Quality",
            "description": "Counts exact PostgreSQL failure flags before aggregation; opposing deltas cannot cancel.",
            "formatString": "#,0"
          },
          {
            "name": "Quality Status",
            "expression": [
              "VAR FilesPresent = COUNTROWS(FileQuality)",
              "VAR CurrencyRows = CALCULATE(COUNTROWS(CurrencyReconciliation), REMOVEFILTERS(DimCurrency))",
              "VAR AllFailures = CALCULATE([Reconciliation Failures], REMOVEFILTERS(DimCurrency))",
              "VAR BadFiles = COUNTROWS(FILTER(FileQuality, NOT(FileQuality[Row balance OK])))",
              "RETURN IF(FilesPresent = 0 || CurrencyRows = 0, \"NO DATA\",",
              "    IF([Row Balance Variance] = 0 && AllFailures = 0 && BadFiles = 0, \"PASS\", \"CHECK\"))"
            ],
            "displayFolder": "Quality",
            "description": "Overall selected-file status; currency slicers cannot hide another currency failure."
          },
          {
            "name": "Detail Sample Rows",
            "expression": [
              "COUNTROWS(AlertSample)"
            ],
            "displayFolder": "Sample",
            "description": "Bounded highest-score sample; never a population denominator.",
            "formatString": "#,0"
          },
          {
            "name": "Detail Sample Note",
            "expression": [
              "\"Illustrative sample: \" & FORMAT([Detail Sample Rows], \"#,0\") & \" rows in the current context. Full alert workload is \" & FORMAT([Risk Alert Count], \"#,0\") & \".\""
            ],
            "displayFolder": "Sample",
            "description": "The sample is intentionally nonrepresentative and may contain no rows for a valid selection."
          },
          {
            "name": "Publication",
            "expression": [
              "\"Publication \" & FORMAT(MAX(Snapshot[Publication ID]), \"0\") & \" | \" & SELECTEDVALUE(Snapshot[Published at UTC]) & \" | static verified snapshot\""
            ],
            "displayFolder": "Provenance",
            "description": "Publication time is UTC; event timestamps are not assigned a timezone."
          },
          {
            "name": "Selected Period",
            "expression": [
              "FORMAT(MIN(DimDate[Date]), \"dd MMM yyyy\") & \" to \" & FORMAT(MAX(DimDate[Date]), \"dd MMM yyyy\")"
            ],
            "displayFolder": "Provenance",
            "description": "Current date selection."
          }
        ]
      },
      {
        "name": "FileQuality",
        "description": "One row per source file. No event-date relationship.",
        "columns": [
          {
            "name": "File key",
            "dataType": "int64",
            "sourceColumn": "File key",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Source rows",
            "dataType": "int64",
            "sourceColumn": "Source rows",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Accepted rows",
            "dataType": "int64",
            "sourceColumn": "Accepted rows",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Rejected rows",
            "dataType": "int64",
            "sourceColumn": "Rejected rows",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Duplicate candidates",
            "dataType": "int64",
            "sourceColumn": "Duplicate candidates",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Raw rows",
            "dataType": "int64",
            "sourceColumn": "Raw rows",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Staged rows",
            "dataType": "int64",
            "sourceColumn": "Staged rows",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Published rows",
            "dataType": "int64",
            "sourceColumn": "Published rows",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Row balance OK",
            "dataType": "boolean",
            "sourceColumn": "Row balance OK",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "FileQuality",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"i4421DE1MLcwNjGF0MZmOgY6lhhiMLqkqDQ1NhYA\"}),",
                "    Data = Json.Document(Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Data, {\"File key\", \"Source rows\", \"Accepted rows\", \"Rejected rows\", \"Duplicate candidates\", \"Raw rows\", \"Staged rows\", \"Published rows\", \"Row balance OK\"}),",
                "    Selected = Table.SelectColumns(Rows, {\"File key\", \"Source rows\", \"Accepted rows\", \"Rejected rows\", \"Duplicate candidates\", \"Raw rows\", \"Staged rows\", \"Published rows\", \"Row balance OK\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"File key\", Int64.Type}, {\"Source rows\", Int64.Type}, {\"Accepted rows\", Int64.Type}, {\"Rejected rows\", Int64.Type}, {\"Duplicate candidates\", Int64.Type}, {\"Raw rows\", Int64.Type}, {\"Staged rows\", Int64.Type}, {\"Published rows\", Int64.Type}, {\"Row balance OK\", type logical}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "CurrencyReconciliation",
        "description": "One row per file/currency. Monetary values are exact SQL decimal text; no cross-currency sum.",
        "columns": [
          {
            "name": "File key",
            "dataType": "int64",
            "sourceColumn": "File key",
            "summarizeBy": "none",
            "isHidden": true,
            "formatString": "#,0"
          },
          {
            "name": "Currency",
            "dataType": "string",
            "sourceColumn": "Currency",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Raw source total",
            "dataType": "string",
            "sourceColumn": "Raw source total",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Staged total",
            "dataType": "string",
            "sourceColumn": "Staged total",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Expected current total",
            "dataType": "string",
            "sourceColumn": "Expected current total",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Published total",
            "dataType": "string",
            "sourceColumn": "Published total",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Raw staging delta",
            "dataType": "string",
            "sourceColumn": "Raw staging delta",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Effective core delta",
            "dataType": "string",
            "sourceColumn": "Effective core delta",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Failure count",
            "dataType": "int64",
            "sourceColumn": "Failure count",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "#,0"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "partitions": [
          {
            "name": "CurrencyReconciliation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"\"}),",
                "    Data = Json.Document(Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate)),",
                "    Rows = Table.FromRows(Data, {\"File key\", \"Currency\", \"Raw source total\", \"Staged total\", \"Expected current total\", \"Published total\", \"Raw staging delta\", \"Effective core delta\", \"Failure count\", \"Status\"}),",
                "    Selected = Table.SelectColumns(Rows, {\"File key\", \"Currency\", \"Raw source total\", \"Staged total\", \"Expected current total\", \"Published total\", \"Raw staging delta\", \"Effective core delta\", \"Failure count\", \"Status\"}),",
                "    Typed = Table.TransformColumnTypes(Selected, {{\"File key\", Int64.Type}, {\"Currency\", type text}, {\"Raw source total\", type text}, {\"Staged total\", type text}, {\"Expected current total\", type text}, {\"Published total\", type text}, {\"Raw staging delta\", type text}, {\"Effective core delta\", type text}, {\"Failure count\", Int64.Type}, {\"Status\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "AlertSample",
        "description": "Up to three highest-rule-score alerts per date/currency. Nonrepresentative bounded detail sample.",
        "columns": [
          {
            "name": "Reference",
            "dataType": "string",
            "sourceColumn": "Reference",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "dd MMM yyyy",
            "annotations": [
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "Event time (source)",
            "dataType": "string",
            "sourceColumn": "Event time (source)",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Currency",
            "dataType": "string",
            "sourceColumn": "Currency",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "Payment format",
            "dataType": "string",
            "sourceColumn": "Payment format",
